{
  "id": "static_route",
  "name": "静态路由配置",
  "category": "routing",
  "device_types": ["路由器", "三层交换机"],
  "description": "配置静态路由实现跨网段通信",
  "prerequisites": [
    "设备已配置接口IP地址",
    "下一跳地址可达"
  ],
  "steps": [
    {
      "step": 1,
      "name": "进入系统视图",
      "description": "",
      "commands": ["system-view"],
      "notes": []
    },
    {
      "step": 2,
      "name": "配置静态路由",
      "description": "指定目的网段、掩码和下一跳",
      "commands": ["ip route-static [dest-ip] [mask] [next-hop]"],
      "notes": [
        "默认路由: ip route-static 0.0.0.0 0.0.0.0 [next-hop]",
        "也可以指定出接口代替下一跳"
      ]
    },
    {
      "step": 3,
      "name": "退出并保存",
      "description": "",
      "commands": ["return", "save"],
      "notes": []
    }
  ],
  "verification": [
    "display ip routing-table",
    "display ip routing-table protocol static",
    "ping [dest-ip]"
  ],
  "common_errors": [
    {
      "error": "路由不生效",
      "cause": "下一跳不可达或出接口未UP",
      "solution": "检查下一跳是否在直连网段内，确认接口状态"
    }
  ],
  "tips": [
    "使用 display ip routing-table 查看完整路由表",
    "默认路由优先级为60，可手动调整"
  ],
  "related_methods": ["ospf_basic", "rip_basic"],
