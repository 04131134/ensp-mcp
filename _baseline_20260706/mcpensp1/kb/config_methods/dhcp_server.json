{
  "id": "dhcp_server",
  "name": "DHCP服务器配置",
  "category": "services",
  "device_types": ["路由器", "三层交换机"],
  "description": "配置DHCP服务器为终端自动分配IP地址",
  "prerequisites": [
    "设备已配置接口IP地址",
    "DHCP功能已启用"
  ],
  "steps": [
    {
      "step": 1,
      "name": "进入系统视图",
      "description": "从用户视图进入系统视图",
      "commands": ["system-view"],
      "notes": []
    },
    {
      "step": 2,
      "name": "启用DHCP功能",
      "description": "全局启用DHCP服务",
      "commands": ["dhcp enable"],
      "notes": ["必须先全局启用才能配置地址池"]
    },
    {
      "step": 3,
      "name": "创建地址池",
      "description": "配置IP地址池参数",
      "commands": [
        "ip pool [pool-name]",
        "network [ip-address] mask [mask]",
        "gateway-list [gateway-ip]",
        "dns-list [dns-ip]",
        "lease day [days]"
      ],
      "notes": [
        "pool-name 为地址池名称",
        "lease 默认为1天，可根据需要调整"
      ]
    },
    {
      "step": 4,
      "name": "接口启用DHCP",
      "description": "在接口上启用DHCP服务",
      "commands": [
        "interface [port]",
        "dhcp select global"
      ],
      "notes": [
        "dhcp select global 使用全局地址池",
        "dhcp select interface 使用接口地址池"
      ]
    },
    {
      "step": 5,
      "name": "退出并保存",
      "description": "保存配置",
      "commands": ["return", "save"],
      "notes": ["务必保存配置"]
    }
  ],
  "verification": [
    "display ip pool",
    "display ip pool name [pool-name]",
    "display dhcp server statistics"
  ],
  "common_errors": [
    {
      "error": "终端无法获取IP地址",
      "cause": "地址池网段与接口网段不匹配",
      "solution": "检查地址池 network 配置是否与接口IP同网段"
    },
    {
      "error": "地址池已满",
      "cause": "可用地址已全部分配",
      "solution": "扩大地址池范围或缩短租期"
    }
  ],
  "tips": [
    "使用 display ip pool 查看地址分配情况",
    "使用 display ip pool name [pool-name] 查看指定地址池详情",
    "租期设置过短会增加网络广播流量"
  ],
  "related_methods": ["vlanif_ip", "dhcp_relay"],
  "created_at": "2026-06-27T01:40:00+08:00",
  "updated_at": "2026-06-27T01:40:00+08:00",
  "usage_count": 0,
  "success_rate": 0.0
}
