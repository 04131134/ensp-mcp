{
  "id": "firewall_nat_policy",
  "name": "防火墙NAT策略",
  "category": "security",
  "device_types": [
    "防火墙(USG)"
  ],
  "description": "配置防火墙 NAT 策略（源 NAT / 服务器映射）",
  "prerequisites": [
    "已进入系统视图 system-view（防火墙还需先配接口IP并加入安全区域）"
  ],
  "steps": [
    {
      "step": 1,
      "name": "进入系统视图",
      "commands": [
        "system-view"
      ],
      "notes": []
    },
    {
      "step": 2,
      "name": "源NAT(Easy-IP)",
      "commands": [
        "nat-policy",
        "rule name Inside_NAT",
        "source-zone trust",
        "destination-zone untrust",
        "source-address 192.168.1.0 24",
        "action source-nat easy-ip"
      ],
      "notes": [
        "用出接口IP做PAT"
      ]
    },
    {
      "step": 3,
      "name": "服务器映射",
      "commands": [
        "rule name Server_Map",
        "source-zone untrust",
        "destination-zone dmz",
        "destination-address 202.103.0.10 32",
        "service http",
        "action destination-nat static addr-to-addr 172.16.10.10"
      ],
      "notes": []
    }
  ],
  "verification": [
    "display firewall session all",
    "display nat-policy"
  ],
  "common_errors": [
    {
      "error": "NAT 后仍不通",
      "cause": "只配了 NAT 没配放通的安全策略",
      "solution": "同步配置 security-policy 放通对应流量"
    }
  ],
  "tips": [
    "NAT 后仍需安全策略放通",
    "easy-ip 用出接口 IP 做源地址转换"
  ],
  "related_methods": [
    "firewall_security_policy",
    "nat_config"
  ],
