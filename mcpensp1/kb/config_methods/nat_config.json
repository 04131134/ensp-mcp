{
  "id": "nat_config",
  "name": "NAT配置",
  "category": "services",
  "device_types": [
    "路由器",
    "防火墙"
  ],
  "description": "配置 Easy IP(PAT) 与 NAT Server(端口映射)",
  "prerequisites": [
    "已进入系统视图 system-view（防火墙还需先配接口IP并加入安全区域）"
  ],
  "steps": [
    {
      "step": 1,
      "name": "进入系统视图",
      "commands": [
        "system-view"
      ],
      "notes": []
    },
    {
      "step": 2,
      "name": "Easy IP(PAT)",
      "commands": [
        "acl 2000",
        "rule permit source 192.168.1.0 0.0.0.255",
        "interface GigabitEthernet 0/0/1",
        "nat outbound 2000"
      ],
      "notes": [
        "用出接口IP做地址转换"
      ]
    },
    {
      "step": 3,
      "name": "NAT Server",
      "commands": [
        "interface GigabitEthernet 0/0/1",
        "nat server protocol tcp global 202.103.0.10 www inside 192.168.1.100 www"
      ],
      "notes": [
        "将内网服务器映射到公网"
      ]
    }
  ],
  "verification": [
    "display nat session all"
  ],
  "common_errors": [
    {
      "error": "内网无法上外网",
      "cause": "ACL 未匹配内网网段或出接口未配 nat outbound",
      "solution": "检查 acl rule 与 nat outbound 绑定接口"
    }
  ],
  "tips": [
    "Easy IP 用出接口 IP 做 PAT",
    "防火墙做 NAT 后仍需安全策略放通流量"
  ],
  "related_methods": [
    "acl_config",
    "firewall_nat_policy"
  ],
