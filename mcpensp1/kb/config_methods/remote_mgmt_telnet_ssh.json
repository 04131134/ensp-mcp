{
  "id": "remote_mgmt_telnet_ssh",
  "name": "远程管理(Telnet/SSH)",
  "category": "management",
  "device_types": [
    "路由器",
    "交换机",
    "防火墙"
  ],
  "description": "配置 VTY 线路，启用 Telnet 或 SSH 远程管理",
  "prerequisites": [
    "已进入系统视图 system-view（防火墙还需先配接口IP并加入安全区域）"
  ],
  "steps": [
    {
      "step": 1,
      "name": "进入系统视图",
      "commands": [
        "system-view"
      ],
      "notes": []
    },
    {
      "step": 2,
      "name": "Telnet 认证",
      "commands": [
        "user-interface vty 0 4",
        "authentication-mode password",
        "set authentication password cipher Huawei@123",
        "protocol inbound telnet",
        "user privilege level 3"
      ],
      "notes": [
        "password 认证方式"
      ]
    },
    {
      "step": 3,
      "name": "生成RSA密钥(SSH用)",
      "commands": [
        "rsa local-key-pair create"
      ],
      "notes": [
        "SSH/stelnet 必须先生成密钥"
      ]
    },
    {
      "step": 4,
      "name": "VTY 启用 SSH",
      "commands": [
        "user-interface vty 0 4",
        "authentication-mode aaa",
        "protocol inbound ssh"
      ],
      "notes": [
        "SSH 用 AAA 认证"
      ]
    },
    {
      "step": 5,
      "name": "创建本地用户",
      "commands": [
        "aaa",
        "local-user admin password cipher Huawei@123",
        "local-user admin privilege level 15",
        "local-user admin service-type ssh"
      ],
      "notes": [
        "防火墙用 manager-user admin"
      ]
    }
  ],
  "verification": [
    "display user-interface",
    "display ssh server status"
  ],
  "common_errors": [
    {
      "error": "SSH 登录提示无密钥",
      "cause": "未执行 rsa local-key-pair create",
      "solution": "先生成 RSA 密钥对"
    },
    {
      "error": "登录后权限不足",
      "cause": "user privilege level 过低或未配 service-type",
      "solution": "提升权限级别并指定 service-type"
    }
  ],
  "tips": [
    "SSH 加密更安全，推荐优先于 Telnet",
    "防火墙还需在接口下 service-manage ssh permit"
  ],
  "related_methods": [
    "interface_basic",
    "firewall_web_login"
  ],
