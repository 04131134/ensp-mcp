{
  "id": "ac_ap_wireless",
  "name": "AC+AP无线网络配置",
  "category": "wireless",
  "device_types": ["AC6605", "AP3030DN"],
  "description": "配置AC控制器和FIT AP，实现WiFi无线覆盖",
  "prerequisites": [
    "AC和AP已物理连接",
    "AP管理VLAN已规划 (如VLAN 100)",
    "无线用户VLAN已规划 (如VLAN 101)",
    "AC的上行口已配置trunk"
  ],
  "steps": [
    {
      "step": 1,
      "name": "AC基础配置",
      "commands": [
        "system-view",
        "sysname AC",
        "undo info-center enable",
        "vlan batch 100 to 101",
        "dhcp enable"
      ],
      "notes": ["VLAN 100为AP管理VLAN", "VLAN 101为无线用户VLAN"]
    },
    {
      "step": 2,
      "name": "AC接口配置",
      "commands": [
        "interface Vlanif100",
        "ip address 192.168.100.1 255.255.255.0",
        "dhcp select interface",
        "quit",
        "interface GigabitEthernet0/0/19",
        "port link-type trunk",
        "port trunk allow-pass vlan 2 to 4094",
        "quit"
      ],
      "notes": ["dhcp select interface 使用接口IP作为DHCP网关", "GE0/0/19连接核心交换机"]
    },
    {
      "step": 3,
      "name": "CAPWAP源接口 (关键!)",
      "commands": [
        "capwap source interface Vlanif100"
      ],
      "notes": ["这是AP发现AC的关键配置!", "不配置则AP无法上线"]
    },
    {
      "step": 4,
      "name": "AAA配置",
      "commands": [
        "aaa",
        "local-user admin password irreversible-cipher YourPassword",
        "local-user admin privilege level 15",
        "local-user admin service-type http",
        "quit"
      ],
      "notes": ["用于AC的Web管理登录"]
    },
    {
      "step": 5,
      "name": "WLAN安全配置",
      "commands": [
        "wlan",
        "security-profile name sec",
        "security wpa-wpa2 psk pass-phrase YourPassword aes",
        "quit"
      ],
      "notes": ["WPA2-PSK加密", "密码建议8位以上"]
    },
    {
      "step": 6,
      "name": "WLAN SSID配置",
      "commands": [
        "ssid-profile name ssid",
        "ssid YourSSID",
        "quit"
      ],
      "notes": ["SSID是WiFi名称"]
    },
    {
      "step": 7,
      "name": "WLAN VAP配置",
      "commands": [
        "vap-profile name vap",
        "service-vlan vlan-id 101",
        "ssid-profile ssid",
        "security-profile sec",
        "quit"
      ],
      "notes": ["service-vlan是无线用户的VLAN", "绑定SSID和安全配置"]
    },
    {
      "step": 8,
      "name": "AP分组配置",
      "commands": [
        "ap-group name ap",
        "radio 0",
        "vap-profile vap wlan 1",
        "quit",
        "radio 1",
        "vap-profile vap wlan 1",
        "quit",
        "quit"
      ],
      "notes": ["radio 0 = 2.4G", "radio 1 = 5G", "两个射频都绑定VAP"]
    },
    {
      "step": 9,
      "name": "AP认证模式 (关键!)",
      "commands": [
        "ap auth-mode no-auth"
      ],
      "notes": ["必须在wlan视图下执行!", "允许所有AP自动加入", "生产环境建议用MAC认证"]
    },
    {
      "step": 10,
      "name": "AP手动注册",
      "commands": [
        "ap-id 1 type-id 56 ap-mac xxxx-xxxx-xxxx ap-sn XXXXXXXXXXXX",
        "ap-name ap1",
        "ap-group ap",
        "quit",
        "provision-ap"
      ],
      "notes": ["type-id 56 = AP3030DN", "MAC和SN必须匹配实际设备", "provision-ap下发配置"]
    },
    {
      "step": 11,
      "name": "交换机AP端口配置",
      "commands": [
        "interface GigabitEthernet0/0/3",
        "port link-type trunk",
        "port trunk pvid vlan 100",
        "port trunk allow-pass vlan 2 to 4094",
        "quit"
      ],
      "notes": ["pvid vlan 100 是关键!", "AP发送untagged帧，需要pvid指定管理VLAN"],
      "device": "汇聚交换机"
    }
  ],
  "verification": [
    "display ap all → State应为nor, IP有地址",
    "display vap all → Status应为ON, SSID正确",
    "display radio all → 2.4G和5G都应ST=on"
  ],
  "common_errors": [
    {
      "error": "AP状态为idle",
      "cause": "缺少capwap source或ap auth-mode",
      "solution": "检查capwap source interface和ap auth-mode no-auth"
    },
    {
      "error": "AP无法获取IP",
      "cause": "AP端口未配置pvid或DHCP未启用",
      "solution": "检查AP端口的trunk pvid vlan 100和AC的dhcp配置"
    },
    {
      "error": "VAP不广播",
      "cause": "ap-group未绑定vap-profile",
      "solution": "检查ap-group下的radio配置"
    },
    {
      "error": "核心交换机Vlanif100冲突",
      "cause": "核心交换机也配了Vlanif100导致DHCP冲突",
      "solution": "删除核心交换机的Vlanif100，只在AC上配置"
    }
  ],
  "tips": [
    "AP上线需要30-60秒，请耐心等待",
    "capwap source是最容易遗漏的命令",
    "AP口的pvid配置是第二个容易遗漏的点",
    "ap auth-mode必须在wlan视图下执行",
    "建议先配置好AC，再启动AP"
  ],
  "related_methods": ["vlan_config", "dhcp_server"],
  "usage_count": 1,
  "success_rate": 1.0,
  "last_used": "2026-06-27",
  "experiment": "校园网综合设计实训"
}
